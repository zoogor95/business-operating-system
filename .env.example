# Local development defaults. Copy to `.env` (git-ignored) and adjust if needed:
#   cp .env.example .env
# Docker Compose and the API both read the repo-root `.env`.

# --- Docker Compose (docker-compose.yml) --------------------------------------
POSTGRES_USER=bos
POSTGRES_PASSWORD=bos
POSTGRES_DB=bos
# Host ports. Postgres uses 5433 so it never collides with a locally installed
# Postgres on 5432. If you change a port, update the matching URL/port below.
POSTGRES_PORT=5433
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- API (apps/api) ------------------------------------------------------------
PORT=3000
# The API logs in as `bos_api`, a member of the `bos_app` role: no superuser, no BYPASSRLS, so
# Row-Level Security applies to every query. Create it locally with `pnpm db:dev-role`.
DATABASE_URL=postgres://bos_api:bos_api@localhost:5433/bos
# Migrations, `pnpm db:verify` and `pnpm db:dev-role` run as the database owner.
MIGRATION_DATABASE_URL=postgres://bos:bos@localhost:5433/bos
REDIS_URL=redis://localhost:6379
# Mailpit in dev; a real transactional provider in staging/production.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="BOS <no-reply@bos.local>"
